# Copy this file to `.env` in the repository root and fill in your key.
# The system reads it with python-dotenv at startup; nothing else is required.

# OpenRouter API key. Used for every LLM call (planner, answerer, judge) and
# for the text-embedding-3-small embeddings via the OpenAI-compatible endpoint.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional. Absolute path to the folder of corpus PDFs.
# Defaults to ./ResearchPapers if unset. See README "Corpus" for why the
# PDFs are not in this repository.
# CORPUS_DIR=C:\path\to\ResearchPapers
